# Environment variables read by pytest-json-ctrf to fill the report's
# results.environment object (and tests[].type). All of them are optional: a variable that is
# not set (or empty) is left out of the report, there are no default values.
# osPlatform, osRelease and osVersion are always detected automatically.
#
# The plugin reads them from the process environment and does not load .env
# files itself. Set them in your CI job, or copy this file to .env and load it
# with a tool such as pytest-dotenv.

# Name of the build or pipeline
CTRF_BUILD_NAME="Nightly regression"

# Sequential build number. Must be an integer; otherwise a warning is issued
# and buildNumber is omitted from the report
CTRF_BUILD_NUMBER=123

# Link to the build or pipeline run
CTRF_BUILD_URL="https://github.com/org/repo/actions/runs/123"

# Environment the tests ran against, e.g. local, staging, production
CTRF_TEST_ENVIRONMENT="staging"

# Test classification written to every test's "type", e.g. unit, integration, e2e
CTRF_TEST_TYPE="e2e"
